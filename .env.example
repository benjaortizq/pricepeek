SECRET_KEY=
DEBUG=True
# Hosts permitidos separados por comas (vacío = solo localhost). Para el celular en la misma red:
# ALLOWED_HOSTS=localhost,127.0.0.1,192.168.x.x
ALLOWED_HOSTS=
DB_NAME=pricepeek
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Postgres local (Mac/Homebrew): disable. Supabase u otro servidor remoto: require
DB_SSLMODE=disable
# Correo: déjelo vacío para ver los correos en la consola del runserver.
# Gmail: use una "contraseña de aplicación" (https://myaccount.google.com/apppasswords), no su contraseña normal.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
DEFAULT_FROM_EMAIL=PricePeek <su_correo@gmail.com>
# Actualización de precios (python manage.py actualizar_precios): horas entre revisiones de un mismo precio
PRECIOS_FRECUENCIA_HORAS=24
# Ejecución manual de la obtención de datos (panel de administración › Obtención de datos)
# En el servidor de PricePeek (True/False):
OBTENCION_EN_EL_SERVIDOR=True
# En GitHub Actions: token "fine-grained" (https://github.com/settings/personal-access-tokens) solo
# para este repositorio, con el permiso Actions: Read and write. Vacío = opción desactivada.
GITHUB_ACTIONS_TOKEN=
GITHUB_REPOSITORIO=benjaortizq/pricepeek
GITHUB_WORKFLOW_PRECIOS=actualizar-precios.yml
GITHUB_RAMA=main
